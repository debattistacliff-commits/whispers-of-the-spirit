<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(GhostboxPlatform)' == 'Windows'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(GhostboxPlatform)' == 'Android'">net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType><RootNamespace>Ghostbox.App</RootNamespace>
    <UseMaui>true</UseMaui><SingleProject>true</SingleProject><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationTitle>Whispers of the Spirit</ApplicationTitle><ApplicationId>uk.whispers.development</ApplicationId>
    <ApplicationTitle Condition="'$(TargetFramework)' == 'net10.0-android'">Whispers of the Spirit</ApplicationTitle>
    <ApplicationDisplayVersion>2.3</ApplicationDisplayVersion><ApplicationVersion>14</ApplicationVersion>
    <ApplicationDisplayVersion Condition="'$(TargetFramework)' == 'net10.0-android'">2.3</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(TargetFramework)' == 'net10.0-android'">14</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">10.0.17763.0</TargetPlatformMinVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk Condition="'$(TargetFramework)' == 'net10.0-android'">true</EmbedAssembliesIntoApk>
    <DefaultItemExcludes>$(DefaultItemExcludes);WebConsole\tools\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="WebConsole\console.html" LogicalName="Whispers.Console.html" />
    <EmbeddedResource Include="WebConsole\review-deck.js" LogicalName="Whispers.ReviewDeck.js" />
    <EmbeddedResource Include="WebConsole\console-live.js" LogicalName="Whispers.ConsoleLive.js" />
    <EmbeddedResource Include="WebConsole\console.offline.css" LogicalName="Whispers.Console.css" />
    <!-- Extra "Material" skin for the phone only. -->
    <EmbeddedResource Condition="'$(TargetFramework)' == 'net10.0-android'" Include="WebConsole\phone-material.js" LogicalName="Whispers.PhoneMaterial.js" />
    <EmbeddedResource Condition="'$(TargetFramework)' == 'net10.0-android'" Include="WebConsole\phone-i18n.js" LogicalName="Whispers.PhoneI18n.js" />
    <EmbeddedResource Condition="'$(TargetFramework)' == 'net10.0-android'" Include="WebConsole\phone-sls.js" LogicalName="Whispers.PhoneSls.js" />
    <!-- Windows: Settings, languages, Material/Ember skins and the SLS camera (webcam) in the classic layout. -->
    <EmbeddedResource Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" Include="WebConsole\desktop-shell.js" LogicalName="Whispers.DesktopShell.js" />
    <EmbeddedResource Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" Include="WebConsole\phone-i18n.js" LogicalName="Whispers.PhoneI18n.js" />
    <EmbeddedResource Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" Include="WebConsole\phone-sls.js" LogicalName="Whispers.PhoneSls.js" />
    <Content Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" Include="Platforms\Android\Assets\sls\*" Link="sls\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Optional Xbox 360 Kinect helper (built by scripts/build-windows.ps1 where the Kinect for Windows SDK 1.8 is installed). -->
    <Content Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0' And Exists('..\Ghostbox.Kinect\bin\Release\net48\WhispersKinect.exe')" Include="..\Ghostbox.Kinect\bin\Release\net48\WhispersKinect.exe*" Link="kinect\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <MauiIcon Condition="'$(TargetFramework)' != 'net10.0-windows10.0.19041.0'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#050b13" />
    <!-- Windows window, taskbar and .exe use the same haunted-radio artwork as the Android launcher. -->
    <MauiIcon Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" Include="Resources\AppIcon\whispers_windows.png" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#050b13" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="..\Licenses\*" LogicalName="Licenses/%(Filename)%(Extension)" />
    <MauiAsset Include="..\THIRD-PARTY.md" LogicalName="Licenses/THIRD-PARTY.md" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <ProjectReference Include="..\Ghostbox.Core\Ghostbox.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="VideoLAN.LibVLC.Android" Version="3.7.0-beta" />
  </ItemGroup>
</Project>

